# Namma Trip - Frontend Environment Configuration (Vercel / Local)
# When deploying on Vercel, point this to your Render backend URL (e.g. https://namma-trip-api.onrender.com)
VITE_API_BASE_URL=/api

# Optional: Supabase Client credentials for direct client auth
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
